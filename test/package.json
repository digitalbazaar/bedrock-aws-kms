{
  "name": "bedrock-aws-kms-test",
  "version": "0.0.1-0",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --preserve-symlinks test.js test",
    "coverage": "cross-env NODE_ENV=test c8 --reporter=lcov --reporter=text-summary npm test",
    "coverage-ci": "cross-env NODE_ENV=test c8 --reporter=lcovonly npm test",
    "coverage-report": "c8 report"
  },
  "dependencies": {
    "@bedrock/aws-kms": "file:..",
    "@bedrock/core": "^6.3.0",
    "@bedrock/https-agent": "^4.1.0",
    "@bedrock/server": "^5.1.0",
    "@bedrock/test": "^9.0.0",
    "@bedrock/validation": "^7.1.1",
    "@digitalbazaar/ed25519-verification-key-2020": "^4.2.0",
    "base64url-universal": "^2.0.0",
    "bnid": "^3.0.0",
    "c8": "^11.0.0",
    "cross-env": "^10.1.0"
  },
  "c8": {
    "excludeNodeModules": false,
    "include": [
      "node_modules/bedrock-aws-kms/**"
    ],
    "exclude": [
      "node_modules/bedrock-aws-kms/node_modules/**"
    ]
  }
}
